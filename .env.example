# Save a copy of this file as .env and fill it in before you deploy. Keep the
# completed copy out of version control.

# Key for the account that signs and broadcasts the deployment. It needs ETH on
# Robinhood Chain for gas.
PRIVATE_KEY=0x...

# Address allowed to write KYC tiers into AccountRegistry.
COMPLIANCE_AUTHORITY=0x...

# USDG, the Global Dollar on Robinhood Chain. Glade settles in it:
# ConfidentialToken wraps it, and agents spend it unless told otherwise.
USDG_ADDRESS=0x...

# Groth16 verifier used for confidential transfers. Leave this empty and the
# script deploys StubTransferVerifier for bring-up instead. Swap in the real
# verifier before anything valuable gets wrapped.
TRANSFER_VERIFIER_ADDRESS=

# Where collected fees go. Setting it makes the script deploy FeeSchedule too
# and point the protocol at it. Leave it empty to launch with fees off.
TREASURY=

# API key for Blockscout, read by `forge verify-contract`. Leaving it empty is
# normally fine.
BLOCKSCOUT_API_KEY=
